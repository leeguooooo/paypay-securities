# Default account: copy to ~/.paypay-sec/.env and fill in. NEVER commit it.
# Additional accounts: copy to ~/.paypay-sec/<name>.env, then use `paypay <cmd> -a <name>`.
PAYPAY_MEMBER_ID=Pxxxxxxxxx
PAYPAY_PASSWORD=your-password

# Full Cookie header string copied from a logged-in browser session.
# MUST contain the trusted-device token (..._SMS_AUTH_STRING=...) so login
# skips SMS. Without it the server may set IF_NEED_SMS_FLG=1 and login fails.
PAYPAY_COOKIE=<account-no>_SMS_AUTH_STRING=...; _ga=...

# Optional; matches the captured web login. Default: uuid_pc
PAYPAY_UUID=uuid_pc

# --- Mobile API (paypay_sec.mobile_client) — optional ---
# Captured ONCE from the Android app's login request (MITM). See
# research/mobile_fixtures/API_MAP.md. NOTE: BFF data endpoints currently 401
# for old-version logins (passkey gate, code 00156) — login works, data doesn't.
PAYPAY_ENCRYPTED_PASSWORD=   # deterministic password ciphertext (hex), reusable
PAYPAY_SMS_AUTH_STRING=      # trusted-device token (hex)
PAYPAY_MOBILE_UUID=          # UUID the app logs in with
PAYPAY_APP_VERSION=3.48.6    # bump to test a newer build against the BFF gate
PAYPAY_DEVICE_TOKEN=x        # FCM token; "x" is accepted for login
