#!/usr/bin/env bash
# Location-independent launcher — run `paypay` from any directory.
# Symlink onto your PATH. The skill dir depends on your runner — it may be under
# ~/.claude/skills, ~/.hermes/skills, ~/.agents/skills, … — so point at THIS file:
#   ln -s "<skill-dir>/bin/paypay" ~/.local/bin/paypay   # adjust to your install
# then: paypay review --format lark   (this launcher resolves the symlink itself)
set -euo pipefail
# Resolve symlinks so SKILL_DIR is the REAL skill dir even when this launcher is
# invoked through a PATH symlink (e.g. ~/.local/bin/paypay). Without this,
# ${BASH_SOURCE[0]} is the symlink path and SKILL_DIR would wrongly become e.g.
# ~/.local — making `uv run --project` grab the wrong venv (or recurse).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$DIR/$SOURCE"   # relative → absolute
done
SKILL_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
# Drop an outer VIRTUAL_ENV so `uv run` doesn't print the
# "VIRTUAL_ENV does not match the project environment" warning, and so it uses
# THIS project's .venv (not an activated shell venv).
unset VIRTUAL_ENV
# Run the module (NOT the `paypay` console-script name): once symlinked onto PATH
# as `paypay`, `uv run paypay` could resolve back to this launcher and loop.
# `python -m paypay_sec` is unambiguous and can't recurse.
exec uv run --project "$SKILL_DIR" python -m paypay_sec "$@"
